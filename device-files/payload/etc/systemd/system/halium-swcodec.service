[Unit]
Description=Start Android software Codec2 service (video decoding backend)
After=lxc-android-config.service
# Gates NOTHING, per project rule 3. Nothing orders itself after this unit and
# it detaches immediately, so it can never delay or block the boot.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'setsid /usr/lib/halium/halium-swcodec.sh >/dev/null 2>&1 < /dev/null &'
TimeoutStartSec=15

[Install]
WantedBy=multi-user.target
