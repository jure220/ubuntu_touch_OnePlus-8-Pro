# WiFi (added 2026-10-05). The qcacld driver's config INI, staged by
# halium-wlan.sh as wlan/qca_cld/WCNSS_qcom_cfg.ini. wlan/ is not copied into
# /odm, only read by halium-wlan.sh.
wlan/WCNSS_qcom_cfg.ini vendor/etc/wifi/WCNSS_qcom_cfg.ini
