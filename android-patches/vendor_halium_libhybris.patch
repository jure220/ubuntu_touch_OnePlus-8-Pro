@@ -76,7 +78,37 @@ public:
 
     virtual ~HWComposerCallback() { };
 private:
+    /*
+     * The composer HAL brings the built-in panel up before any external
+     * display can be hotplugged, so the first display id we are ever told
+     * about is the primary one. This is the same rule SurfaceFlinger applies
+     * in HWComposer::onHotplugConnect(); there is no other way to identify
+     * the primary display through the HWC2 hotplug callback, whose display
+     * ids are opaque.
+     *
+     * This used to report every display as primary. Clients key their display
+     * slots off this flag (Mir: display_id = primaryDisplay ? HWC_DISPLAY_PRIMARY
+     * : HWC_DISPLAY_EXTERNAL), so an external monitor would overwrite the
+     * built-in panel's slot -- driving the panel at the monitor's mode on
+     * connect, and tearing the panel down on disconnect.
+     *
+     * The id is remembered for the lifetime of the callback and is not
+     * forgotten on disconnect, so that a primary display which disconnects and
+     * comes back is still reported as primary.
+     */
+    bool isPrimaryDisplay(hal::HWDisplayId display) {
+        std::lock_guard<std::mutex> lock(primaryDisplayMutex);
+        if (!primaryDisplayKnown) {
+            primaryDisplayKnown = true;
+            primaryDisplayId = display;
+        }
+        return display == primaryDisplayId;
+    }
+
     HWC2EventListener *listener;
+    std::mutex primaryDisplayMutex;
+    hal::HWDisplayId primaryDisplayId = 0;
+    bool primaryDisplayKnown = false;
 };
 
