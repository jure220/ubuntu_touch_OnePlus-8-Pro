diff --git a/compat/media/media_recorder_layer.cpp b/compat/media/media_recorder_layer.cpp
index d3e17e7..83260e6 100644
--- a/compat/media/media_recorder_layer.cpp
+++ b/compat/media/media_recorder_layer.cpp
@@ -143,6 +143,16 @@ public:
         media_recorder_listener->setReadAudioCb(cb, context);
     }
 
+    // Camera::getRecordingProxy() returns a FRESH object on every call. If the
+    // only reference is the temporary passed to setCamera(), it is destroyed as
+    // soon as that call returns, the remote side sees the binder die
+    // ("CameraSource: Camera recording proxy died"), and CameraSource falls
+    // back to calling ICamera::setVideoTarget() itself -- from the media
+    // process, which is not the pid that opened the camera, so Camera2Client
+    // ::checkPid() rejects it with PERMISSION_DENIED and recording produces a
+    // 0-byte file. Keep the proxy alive here for as long as the recorder lives.
+    android::sp<android::ICameraRecordingProxy> recording_proxy;
+
 private:
     android::sp<MediaRecorderListenerWrapper> media_recorder_listener;
 };
@@ -233,7 +243,34 @@ int android_recorder_setCamera(MediaRecorderWrapper *mr, CameraControl* control)
     }
 
     mr->init();
-    return mr->setCamera(control->camera->remote(), control->camera->getRecordingProxy());
+
+    // Release the camera before handing it to the recorder.
+    //
+    // ICameraRecordingProxy.h documents the sequence, and step 1 is
+    // "The app: Camera.unlock()" -- BEFORE MediaRecorder::setCamera(). Without
+    // it the handover inside CameraSource::isCameraAvailable() does
+    // Camera::create(camera) -> camera->connect(mediaSideClient), which in
+    // Camera2Client::connect() overwrites mRemoteCallback and
+    // mSharedCameraCallbacks while the app still owns them. On this port the
+    // app's client is then torn down, the device reports an error, and by the
+    // time CameraSource calls setVideoTarget() the camera is DISCONNECTED:
+    //     Camera recording proxy died
+    //     notifyError: Error condition 0 reported by HAL
+    //     setVideoTarget: Cannot set video target while in state DISCONNECTED
+    // and recording writes a 0-byte file.
+    //
+    // unlock() clears those callbacks cleanly and leaves mClientPid 0, which is
+    // exactly the state connect() expects to take over from. Doing it here --
+    // in the compat layer that owns the handover -- means every UT camera app
+    // gets the documented behaviour without each one having to remember to call
+    // android_camera_unlock() itself.
+    int unlock_err = control->camera->unlock();
+    if (unlock_err != android::OK)
+        ALOGW("camera unlock() before setCamera returned %d; handover may fail",
+              unlock_err);
+
+    mr->recording_proxy = control->camera->getRecordingProxy();
+    return mr->setCamera(control->camera->remote(), mr->recording_proxy);
 }
 
