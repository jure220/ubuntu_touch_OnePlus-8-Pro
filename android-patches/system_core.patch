+    #reboot_on_failure reboot,boringssl-self-check-failed
     stdio_to_kmsg
     # Explicitly specify that boringssl_self_test_apex32 doesn't require any capabilities
     capabilities
     user nobody
 
 service boringssl_self_test_apex64 /apex/com.android.conscrypt/bin/boringssl_self_test64
-    reboot_on_failure reboot,boringssl-self-check-failed
+    # HALIUM(instantnoodlep): reboot_on_failure disabled for bring-up.
+    # Android init holds CAP_SYS_BOOT, so a failure here reboots the WHOLE
