+    # the apex self-tests exec from /apex/... which only exists once apexd has
+    # mounted the apexes. Failing loudly in the log is what we want here.
+    #reboot_on_failure reboot,boringssl-self-check-failed
     stdio_to_kmsg
     # Explicitly specify that boringssl_self_test_apex64 doesn't require any capabilities
     capabilities
@@ -1101,7 +1125,11 @@ on zygote-start
     # wait_for_prop odsign.verification.done 1
 
     # A/B update verifier that marks a successful boot.
-    exec_start update_verifier
+    # Halium: update_verifier is part of the A/B OTA flow, which does not exist
+    # here. Inside the LXC container it finds no valid update state and calls
+    # sys.powerctl=reboot, which tears the whole container down in a loop:
+    #   init: Received sys.powerctl='reboot' from pid: N (/system/bin/update_verifier)
+    # exec_start update_verifier
     start statsd
     start netd
     start zygote
