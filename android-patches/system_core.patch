# system/core
# base: 46cf8beed7bdee93afca71fc22cf6e716a59b5bd (halium) fastboot: don't request AIDL HALs for UBports recovery
# apply from the tree root: git -C system/core apply $PWD/<this file>
diff --git a/rootdir/init.rc b/rootdir/init.rc
index bfc91ec..225efce 100644
--- a/rootdir/init.rc
+++ b/rootdir/init.rc
@@ -502,28 +502,52 @@ on init
 import /system/etc/init/hw/init.boringssl.${ro.zygote}.rc
 
 service boringssl_self_test32 /system/bin/boringssl_self_test32
-    reboot_on_failure reboot,boringssl-self-check-failed
+    # HALIUM(instantnoodlep): reboot_on_failure disabled for bring-up.
+    # Android init holds CAP_SYS_BOOT, so a failure here reboots the WHOLE
+    # PHONE (not just the container) and burns an A/B retry. These checks are
+    # meaningless under Halium: storage and /data belong to Ubuntu Touch, and
+    # the apex self-tests exec from /apex/... which only exists once apexd has
+    # mounted the apexes. Failing loudly in the log is what we want here.
+    #reboot_on_failure reboot,boringssl-self-check-failed
     stdio_to_kmsg
     # Explicitly specify that boringssl_self_test32 doesn't require any capabilities
     capabilities
     user nobody
 
 service boringssl_self_test64 /system/bin/boringssl_self_test64
-    reboot_on_failure reboot,boringssl-self-check-failed
