diff --git a/arch/arm64/configs/vendor/halium.config b/arch/arm64/configs/vendor/halium.config
new file mode 100644
index 000000000..63ba8a3a4
--- /dev/null
+++ b/arch/arm64/configs/vendor/halium.config
@@ -0,0 +1,194 @@
+# Halium / Ubuntu Touch kernel requirements for instantnoodlep (sm8250, 4.19)
+#
+# !! COMMENT FORMATTING IS LOAD-BEARING IN THIS FILE !!
+# scripts/kconfig/merge_config.sh parses every line matching
+#     ^\(# \)\{0,1\}\(CONFIG_[a-zA-Z0-9_]*\)[= ]
+# so a COMMENT that begins with "# CONFIG_<name>" followed by a space is read
+# as a directive and silently UNSETS that symbol. On 2026-09-02 a comment
+# reading "# CONFIG_BT / BT_BREDR / ... are already =y" disabled Bluetooth
+# outright -- the build succeeded and produced a kernel with
+# "# CONFIG_BT is not set", the exact opposite of what the fragment intended.
+# ALWAYS indent a CONFIG_ name in prose by two or more spaces: "#   CONFIG_BT".
+# Verify after every change:
+#   grep -nE "^(# )?CONFIG_[a-zA-Z0-9_]*[= ]" halium.config
+# and confirm every hit is a real directive, not prose.
+#
+# Merged as a fragment on top of vendor/kona-perf_defconfig via
+# TARGET_KERNEL_CONFIG in device/oneplus/instantnoodlep/BoardConfig.mk.
+#
+# Every option below was verified to (a) be missing or disabled in the built
+# .config and (b) actually exist in THIS kernel's Kconfig. Options suggested by
+# halium/halium-boot/check-kernel-config that are obsolete in 4.19 were
+# deliberately NOT included -- that script is Halium 9-era and names options
+# from much older kernels:
+#   CONFIG_CGROUP_MEM_RES_CTLR*        -> renamed CONFIG_MEMCG in 3.6 (already =y)
+#   CONFIG_CC_STACKPROTECTOR           -> renamed CONFIG_STACKPROTECTOR in 4.18
+#   CONFIG_DEBUG_RODATA                -> renamed CONFIG_STRICT_KERNEL_RWX in 4.11
+#   CONFIG_DEVPTS_MULTIPLE_INSTANCES   -> removed in 4.7
+#   CONFIG_NETFILTER_TPROXY            -> removed
+#   CONFIG_RTC_DRV_CMOS                -> x86 only, meaningless on ARM
+
+# --- systemd hard requirements ---------------------------------------------
+# Ubuntu Touch runs systemd as PID 1. It refuses to boot without these.
+CONFIG_SYSVIPC=y
+CONFIG_FHANDLE=y
+CONFIG_DEVTMPFS=y
+CONFIG_DEVTMPFS_MOUNT=y
+CONFIG_AUTOFS4_FS=y
+CONFIG_FANOTIFY=y
+
+# --- namespaces -------------------------------------------------------------
+# Halium runs the Android side inside an LXC container.
+CONFIG_NAMESPACES=y
+CONFIG_IPC_NS=y
+CONFIG_PID_NS=y
+CONFIG_USER_NS=y
+
+# --- cgroups ----------------------------------------------------------------
+#   CONFIG_CGROUPS / CGROUP_SCHED / MEMCG / NET_NS are already =y in the
+# stock defconfig; these two are not.
+CONFIG_CGROUP_DEVICE=y
+CONFIG_CGROUP_PERF=y
+
+# --- SELinux must be disableable -------------------------------------------
+# Halium neutralises SELinux (hybris-patches "disable SELinux parts" +
+# libselinux_stubs). Without BOOTPARAM/DISABLE the kernel gives no way to turn
+# it off at runtime.
+CONFIG_SECURITY_SELINUX_BOOTPARAM=y
+CONFIG_SECURITY_SELINUX_DISABLE=y
+
+# --- console ----------------------------------------------------------------
+# Useful for early-boot debugging. FRAMEBUFFER_CONSOLE is deliberately left
+# unset (check-kernel-config also wants it unset) so this cannot fight the
+# display driver.
+CONFIG_VT=y
+CONFIG_VT_CONSOLE=y
+
+# --- USB gadget functions needed by Ubuntu Touch's usb_moded ---
+#
+# THIS IS WHY SSH/RNDIS KEPT DISAPPEARING. usb_moded's "developer_mode" builds
+# the gadget from rndis.usb0, but this kernel shipped with
+#     # CONFIG_USB_CONFIGFS_RNDIS is not set
+# so the function was never registered. The journal shows the whole chain:
+#     /sys/kernel/config/usb_gadget/g1//functions/rndis.usb0: mkdir failed
+#     function rndis.usb0 is not registered
+#     mode developer_mode: network interface rndis0 does not exist
+#     mode setting failed, try charging_only
+# ...and with no network there was no way into the device at all.
+#
+# ECM is enabled too as a fallback transport; NCM was already on (=y), which is
+# why boot 0 fell back to ncm.usb0 and then died on a missing 'wceis' attribute.
+CONFIG_USB_CONFIGFS_RNDIS=y
+CONFIG_USB_CONFIGFS_ECM=y
+CONFIG_USB_CONFIGFS_ECM_SUBSET=y
+
+# --- Wi-Fi (QCA6390) ---
+# The stock vendor ships a prebuilt qca_cld3_qca6390.ko, but it CANNOT be used:
+#     vermagic 4.19.157-perf+   vs our 4.19.324-perf-...
+#     insmod: Required key not available     (CONFIG_MODULE_SIG_FORCE=y)
+# The driver source IS in this kernel tree (drivers/staging/qcacld-3.0, hooked up
+# via obj-$(CONFIG_QCA_CLD_WLAN)), so build it ourselves: it then matches our
+# vermagic AND is auto-signed with our key (CONFIG_MODULE_SIG_ALL=y).
+# Without it there is no wlan interface at all and cnss logs
+#     cnss: QMI WLFW service disconnected
+# configs/qca6390_defconfig is the profile for this chip.
+CONFIG_CNSS_QCA6390=y
+CONFIG_QCA_CLD_WLAN=m
+CONFIG_QCA_CLD_WLAN_PROFILE="qca6390"
+
+# --- Bluetooth (added 2026-09-02) -------------------------------------------
+#
+# WHY: bluetoothd ran fine but /sys/class/bluetooth/ was empty and hciconfig
+# saw no adapter, because there was no HCI transport at all. On Halium the
+# Android BT HAL is bridged into the Linux stack by `bluebinder`, which proxies
+# through /dev/vhci -- and this kernel shipped with
+#     # CONFIG_BT_HCIVHCI is not set
+# so /dev/vhci never existed and bluebinder crash-looped in its pre-start wait
+# (restart counter reached 124). There is no /lib/modules on this device
+# (monolithic kernel), so it has to be built in, not modprobed.
+#
+#   CONFIG_BT / BT_BREDR / BT_LE / BT_SLIM_QCA6390 are already =y in the stock
+# defconfig; only these are missing. All seven verified present in THIS
+# kernel's Kconfig (drivers/bluetooth/Kconfig, net/bluetooth/*/Kconfig) and
+# their deps (NET, UNIX, INPUT, HID, TTY) are all already =y.
+CONFIG_BT_HCIVHCI=y
+
+# Profiles. bluetoothd already logs "kernel lacks bnep-protocol support" and
+# refuses to load its network plugin without BNEP.
+CONFIG_BT_RFCOMM=y
+CONFIG_BT_RFCOMM_TTY=y
+CONFIG_BT_BNEP=y
+CONFIG_BT_BNEP_MC_FILTER=y
+CONFIG_BT_BNEP_PROTO_FILTER=y
+CONFIG_BT_HIDP=y
+
+# --- Suspend: let repowerd own it (added 2026-09-19) ------------------------
+#
+# WHY: repowerd could not manage suspend at all on this device. Its own log:
+#     DefaultDaemonConfig: Failed to create LibsuspendSystemPowerControl:
+#                          Failed to initialize libsuspend
+#     DefaultDaemonConfig: Trying LogindSystemPowerControl
+#
+# repowerd vendors its own libsuspend (src/adapters/libsuspend/) with exactly
+# three real backends, tried in this order, and NO wakeup_count backend:
+#
+#   earlysuspend_detect()  needs /sys/power/wait_for_fb_sleep   -- absent (4.19)
+#   autosleep_detect()     needs /sys/power/autosleep           -- absent
+#   legacy_detect()        needs /sys/power/state AND requires
+#                          /sys/power/wake_lock to NOT exist    -- it DOES exist
+#
+# That last one is the trap: legacy_detect() is
+#     if (sysfs_file_exists(state_path) && !sysfs_file_exists(wakelock_path))
+# so having   CONFIG_PM_WAKELOCKS=y   (which this defconfig sets, and which
+# Android needs) actively DISQUALIFIES the legacy backend. All three fail and
+# repowerd falls back to logind.
+#
+# Consequences of that fallback, all observed on hardware:
+#   * repowerd only ever *permits* suspend and never initiates one, so the phone
+#     never slept until we added halium-idle-suspend.sh to call
+#     `systemctl suspend` externally.
+#   * every logind suspend/resume cycle makes repowerd run handle_system_resume,
+#     which turns the DISPLAY ON. With the modem waking the SoC within seconds of
+#     each suspend, the screen lit up by itself every few minutes.
+#   * NetworkManager treats each cycle as a real sleep/wake, so wlan0 fully
+#     re-associates (4-way handshake + DHCP) every time and the wifi indicator
+#     drops to the generic "gear" icon during the gap.
+#
+# Enabling autosleep gives repowerd the backend it was designed for: the kernel
+# suspends by itself whenever no wakelock is held and re-suspends immediately
+# after a wakeup, with no logind sleep cycle, no resume event, and therefore no
+# display wake and no NetworkManager churn.
+#
+# autosleep_detect() needs only /sys/power/autosleep; the handler then writes
+# "mem"/"off" there and uses /sys/power/wake_lock and /sys/power/wake_unlock,
+# both of which already exist here because   CONFIG_PM_WAKELOCKS   is already =y.
+# So this single option is all that is missing.
+CONFIG_PM_AUTOSLEEP=y
+
+# Waydroid: waydroid-net.sh installs the lxc-net DHCP checksum fixup
+#   iptables -t mangle -A POSTROUTING -o waydroid0 -p udp --dport 68 -j CHECKSUM --checksum-fill
+# and aborts the whole network setup (set -e + cleanup trap) if the target is
+# missing, which makes `waydroid session start` fail.
+CONFIG_NETFILTER_XT_TARGET_CHECKSUM=m
+
+# Mobile data needs NOTHING from the kernel config.
+#
+# From 2026-09-20 to 2026-09-23 this file enabled the TIPC network protocol, on
+# the theory that netmgrd and the RIL's libdsi_netctrl disagreed on transport.
+# That was wrong: netmgrd was simply stuck waiting for an INetd HIDL service
+# that Halium does not ship, so it never created its UNIX socket.  The fix is
+# the stub service in device-files/netd-stub/ (PERFORMANCE-FINDINGS.md
+# section 24), and mobile data was verified working on the stock netmgrd
+# configuration.  TIPC was removed again: it is an unused network protocol and
+# only extra attack surface.  Do not re-add it for mobile data.
+
+# No NTP write-back to the hardware clock (added 2026-10-04).
+#
+# The PM8150 RTC is owned by the secure firmware: every write from Linux is
+# refused at the SPMI arbiter ("disallowed SPMI write to sid=0, addr=0x6046").
+# With the write-back option on, systemd-timesyncd's synchronised clock made the
+# kernel try to store the time in the RTC, and after each failure it retries
+# about once a second, forever: 1 Hz wakeups while awake, and a kernel log
+# flooded with "Write to RTC control register failed". The wall clock is carried
+# in userspace instead (halium-time.sh). Reading the RTC at boot stays on.
+# CONFIG_RTC_SYSTOHC is not set
